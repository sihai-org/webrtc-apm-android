import("//webrtc.gni")

shared_library("webrtc_apm_jni") {
  sources = [
    "apm_jni.cc",
    "config_generated.h",
    "upstream_generated.h",
  ]
  configs += rtc_common_configs
  # Match rtc_* targets: Chromium's private style plugin rejects WebRTC headers.
  configs -= rtc_remove_configs
  ldflags = [ "-Wl,--version-script=" + rebase_path("exports.map", root_build_dir) ]
  inputs = [ "exports.map" ]
  deps = [
    "//api:make_ref_counted",
    "//api/audio:builtin_audio_processing_builder",
    "//api/environment:environment_factory",
    "//api/task_queue:task_queue",
    "//modules/audio_processing:residual_echo_detector",
  ]
  output_extension = "so"
}
